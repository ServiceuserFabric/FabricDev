	measure 'PL Relative Variance - US Format' = ```
			// Relative Variance with US format
			VAR _Actual = ROUND([Finance Amount], 0)
			VAR _Budget = ROUND([Budget Amount], 0)
			VAR _VariancePct = 
			    IF(
			        NOT(ISBLANK(_Budget)) && _Budget <> 0,
			        ROUND(DIVIDE(_Actual - _Budget, ABS(_Budget)) * 100, 0),
			        BLANK()
			    )
			VAR _IsTotalRow = NOT(ISINSCOPE('Account Schedule'[Account Schedule - Level 2]))
			VAR _Label = 
			    IF(
			        NOT(ISBLANK(_VariancePct)),
			        IF(
			            _VariancePct >= 0,
			            "+" & FORMAT(_VariancePct, "#,0", "en-US") & "%",
			            FORMAT(_VariancePct, "#,0", "en-US") & "%"
			        ),
			        BLANK()
			    )
			RETURN
			IF(
			    NOT(ISBLANK(_VariancePct)),
			    PowerofBI.IBCS.BarChart.RelativeVariance(
			        _VariancePct,
			        _Label,
			        _IsTotalRow,
			        0  // Default 350px width
			    ),
			    BLANK()
			)
			```
		displayFolder: Finance\4. Other\IBCS Charts
		lineageTag: 9934eb07-dece-4528-9dee-09013bf0cda9

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'PL Waterfall US Format' = ```
			// Waterfall with US number format (using . as decimal separator)
			// This ensures proper SVG scaling
			// ADJUSTED: Scale factor of 2 for larger bars
			
			VAR _Variance = [Finance Amount] - [Budget Amount]
			VAR _IsTotalRow = NOT(ISINSCOPE('Account Schedule'[Account Schedule - Level 2]))
			
			// IMPORTANT: Use whole numbers (no decimals) to avoid decimal separator issues
			VAR _VarianceRounded = ROUND(_Variance, 0)
			
			// Format label with US format (. as decimal, , as thousands separator)
			VAR _Label = 
			    IF(
			        _VarianceRounded >= 0,
			        "+" & FORMAT(_VarianceRounded, "#,0", "en-US"),
			        FORMAT(_VarianceRounded, "#,0", "en-US")
			    )
			
			// Calculate max/min variance across all rows - using whole numbers
			VAR _AllVariances = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Account Schedule'[Account Schedule - Level 2]),
			            "@Var", ROUND([Finance Amount] - [Budget Amount], 0)
			        ),
			        ALLSELECTED('Account Schedule')
			    )
			VAR _MaxVar = MAXX(_AllVariances, [@Var])
			VAR _MinVar = MINX(_AllVariances, [@Var])
			
			// Calculate scale - using whole numbers
			// ADJUSTED: Divide by 2 to double the visual size
			VAR _AllActuals = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Account Schedule'[Account Schedule - Level 2]),
			            "@Act", ROUND(ABS([Finance Amount]), 0)
			        ),
			        ALLSELECTED('Account Schedule')
			    )
			VAR _AllBudgets = 
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Account Schedule'[Account Schedule - Level 2]),
			            "@Bud", ROUND(ABS([Budget Amount]), 0)
			        ),
			        ALLSELECTED('Account Schedule')
			    )
			VAR _MaxAbs = MAX(MAXX(_AllActuals, [@Act]), MAXX(_AllBudgets, [@Bud])) / 2
			
			RETURN
			IF(
			    NOT(ISBLANK(_Variance)),
			    PowerofBI.IBCS.BarChart.AbsoluteVariance(
			        _VarianceRounded,      // Use rounded whole number
			        _Label,                 // US formatted label
			        _IsTotalRow,
			        _MaxVar / 2,           // Adjusted max variance (factor 2)
			        _MinVar / 2,           // Adjusted min variance (factor 2)
			        _MaxAbs,               // Adjusted max absolute (factor 2)
			        0,                     // Default width (350px)
			        0                     // Default right padding
			    ),
			    BLANK()
			)
			```
		displayFolder: Finance\4. Other\IBCS Charts
		lineageTag: bbff859b-47b7-4522-9c13-77f0fca9ef96

		changedProperty = DisplayFolder

		changedProperty = Name

