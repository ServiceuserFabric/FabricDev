	measure 'Actuals LY, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Actuals LY],
			        account_schedule[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( account_schedule)
			    )
			VAR _Actuals_LY =
			    ABS ( [Actuals LY] )
			VAR _Result =
			    IF (
			        MAX ( account_schedule[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals_LY, _Revenue )
			    )
			RETURN
			_Result
		displayFolder: Business Central\Finance\1. Actuals\2. Rapportering\%
		lineageTag: 104c0a30-7562-424b-a3e7-adde4c4fd053

