	measure 'Finance Amount BS LCY Budget' =
			/* Fixed vs. BC Accelerator: accelerator summed actuals (Sum of Finance Amount LCY) instead of budget */
			CALCULATE (
			    SUM ( finance_budgets[Budget Amount] ),
			    FILTER (
			        ALL ( 'Calendar'[Date] ),
			        'Calendar'[Date] <= MAX ( 'Calendar'[Date] )
			    ),
			    account[Account Statement Type] = "Balance Sheet"
			)
		displayFolder: Business Central\Finance\1. Actuals\1. Base\_Support
		lineageTag: d36b09cd-1975-4328-b836-7b54779b159d

