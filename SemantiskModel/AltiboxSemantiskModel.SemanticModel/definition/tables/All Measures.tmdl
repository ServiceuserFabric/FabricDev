	measure 'Antal udgående opkald' =
			
			CALCULATE(
			    DISTINCTCOUNT(call_events[call_id]),
			    CONTAINSSTRING(call_events[queue_key], "__CALLOUT_"))
		formatString: #,0
		displayFolder: Puzzel
