		changedProperty = FormatString

	measure 'Actuals, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Finance Amount],'Account Schedule'[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( 'Account Schedule')
			    )
			VAR _Actuals =
			    ABS( [Finance Amount] )
			VAR _Result =
			    IF (
			        MAX ( 'Account Schedule'[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals, _Revenue )
			    )
			RETURN
			_Result
		formatString: " #,0.0\ %;-#,0.0\ %;#,0.0\ %"
		displayFolder: Finance\1. Actuals\2. Rapportering\%
		lineageTag: 7be278db-f390-4069-944d-8eb441fde8ae

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Actuals LY, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Actuals LY],
			        'Account Schedule'[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( 'Account Schedule')
			    )
			VAR _Actuals_LY =
			    ABS ( [Actuals LY] )
			VAR _Result =
			    IF (
			        MAX ( 'Account Schedule'[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals_LY, _Revenue )
			    )
			RETURN
			_Result
		displayFolder: Finance\1. Actuals\2. Rapportering\%
		lineageTag: 86686524-e263-4e9c-8de4-49eb0de71f5c

		changedProperty = DisplayFolder

		changedProperty = Name

