	measure 'Color Gross Margin Deviation %' = ```
			
			VAR _Deviation = [DEV Gross Margin %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Deviation ), "#000000",
			        _Deviation >= 0, "#9AC8A6",
			        "#C89A9A"
			    )
			
			```
