	measure 'Actuals, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Finance Amount],account_schedule[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( account_schedule)
			    )
			VAR _Actuals =
			    ABS( [Finance Amount] )
			VAR _Result =
			    IF (
			        MAX ( account_schedule[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals, _Revenue )
			    )
			RETURN
			_Result
		formatString: #,0.0\ %;-#,0.0\ %;#,0.0\ %
		displayFolder: Business Central\Finance\1. Actuals\2. Rapportering\%
		lineageTag: 94f93651-2cb1-48c9-9b6c-7f7f1980225c

	measure 'Budget Amount' =
			SWITCH (
			    SELECTEDVALUE ( 'Currency Display'[Currency Display], "LCY" ),
			    "GCY", SUM ( finance_budgets[Budget Amount GCY] ),
			    SUM ( finance_budgets[Budget Amount] )
			)
		formatString: #,0
		displayFolder: Business Central\Finance\2. Budget\1. Base
		lineageTag: ee6c1247-219b-4e26-ae36-a012c4f2a117

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Estimate = ```
			VAR _BudgetFY = [Budget FY]
			
			VAR _BudgetYTD = [Budget YTD]
			
			VAR _ActualYTD = [Actuals YTD]
			
			VAR _RESULT = _BudgetFY - _BudgetYTD + _ActualYTD
			
			RETURN
			    
			_RESULT
			
			
			
			
			
			```
		formatString: #,0
		displayFolder: Business Central\Finance\2. Budget\2. Rapportering\Forecast
		lineageTag: 6d85a873-90fb-4c9d-adab-8f120d7c7bd2

