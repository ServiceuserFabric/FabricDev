table Calendar
	lineageTag: a426c13c-8cca-4223-9a55-d61e8b46b5c1
	dataCategory: Time

	column Date
		isKey
		formatString: dd-mm-yyyy
		lineageTag: 70702a84-6c49-465d-8074-16abbb897556
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isCustom":true}

	column År = YEAR(Calendar[Date])
		lineageTag: 6b3ead0c-cdc1-475a-929f-ac86a4922418
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Dagsnr = DAY(Calendar[Date])
		formatString: 0
		lineageTag: d098d864-6515-44f1-9af8-7c096eb0c6e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Kvartal = "Q" & FORMAT(Calendar[Date], "Q")
		lineageTag: b16d025a-e45d-4c53-9b95-172538c171f6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Måned = FORMAT(Calendar[Date], "MMMM")
		lineageTag: 7bfaf0bb-956b-4d6a-9ca5-86329aa99aa1
		summarizeBy: none
		sortByColumn: MånedsNr

		annotation SummarizationSetBy = Automatic

	column MånedsNr = MONTH(Calendar[Date])
		formatString: 0
		lineageTag: db72f1ba-aaf0-446f-9d9c-4e2f0c79f263
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Ugedag = WEEKDAY(Calendar[Date])
		formatString: 0
		lineageTag: 45eb8299-9bfd-463e-8673-44451fb974d9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column UgedagNavn = Upper(FORMAT(Calendar[Date],"Dddd", "da-DK"))
		lineageTag: dce38ff3-27e1-4dec-94c1-b4b7b5bec939
		summarizeBy: none
		sortByColumn: Ugedag

		annotation SummarizationSetBy = Automatic

	column Ugenr = WEEKNUM(Calendar[Date],21)
		formatString: 0
		lineageTag: 97e41fcd-9a07-4fb2-ab41-b92936d85c48
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ÅrUge = ```
			'Calendar'[ISOYear] & "-" & FORMAT( WEEKNUM([Date], 21), "00" )
			
			```
		lineageTag: 3da64fa2-f4db-412c-b4dc-e1548379054f
		summarizeBy: none
		sortByColumn: ÅrUgeSort_ISO

		annotation SummarizationSetBy = Automatic

	column ÅrMåned = FORMAT('Calendar'[Date], "YYYY-MM")
		lineageTag: 12f19133-6161-4450-8508-eea68ae9f964
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Aktuel dato (Filter)' = if('Calendar'[Date] = TODAY() - 1, 1, 0)
		formatString: 0
		lineageTag: 7a0379ba-d791-40fa-b317-87e2b13a4bdc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Formål til filterudsnit
	column MonthStart =
			
			DATE ( YEAR ( 'Calendar'[Date] ), MONTH ( 'Calendar'[Date] ), 1 )
		formatString: General Date
		displayFolder: Filterformål
		lineageTag: 22126b30-8636-4ef2-8ff1-96b297443358
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MonthKey =
			
			YEAR ( 'Calendar'[Date] ) * 100 + MONTH ( 'Calendar'[Date] )
		formatString: 0
		displayFolder: Filterformål
		lineageTag: ae1838bc-9f08-4533-af22-043adf4375e7
		summarizeBy: count

		annotation SummarizationSetBy = Automatic

	/// Bruges til at definere indeværende måned i slicer
	column ÅrMåned_Default =
			
			VAR CurrentMonthStart = DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			RETURN
			IF (
			    'Calendar'[MonthStart] = CurrentMonthStart,
			    "Indeværende måned",
			    'Calendar'[ÅrMåned]
			)
		displayFolder: Filterformål
		lineageTag: b8657b41-bacf-46bb-959b-49d361b9e4e2
		summarizeBy: none
		sortByColumn: ÅrMåned

		annotation SummarizationSetBy = Automatic

	column MonthEnd = EOMONTH('Calendar'[MonthStart],0)
		formatString: General Date
		displayFolder: Filterformål
		lineageTag: 40cda7a9-3d11-4ef9-8288-7cda74368b89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Anvendes for at sortere kronologisk for ÅrUge
	column ISOYear = ```
			YEAR ( [Date] - WEEKDAY([Date], 2) + 4 )
			
			```
		formatString: 0
		displayFolder: Sorteringskolonner
		lineageTag: 86fad04c-092b-44d5-9cb8-cb6910635f30
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Denne kolonne anvendes for at ÅrUge sorteres korrekt kronologisk fremfor alfabetisk
	column ÅrUgeSort_ISO = 'Calendar'[ISOYear] * 100 + WEEKNUM([Date],21)
		formatString: 0
		displayFolder: Sorteringskolonner
		lineageTag: 1c8160d7-ad2a-45e5-b208-6cfc264209e7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column ÅrUge_Default = ```
			
			VAR StartOfWeek =
			    TODAY() - WEEKDAY ( TODAY(), 2 ) + 1
			VAR EndOfWeek =
			    StartOfWeek + 6
			RETURN
			IF (
			    MAX ( 'Calendar'[Date] ) >= StartOfWeek
			        && MAX ( 'Calendar'[Date] ) <= EndOfWeek,
			    "Indeværende uge",
			    SELECTEDVALUE ( 'Calendar'[ÅrUge] )
			)
			
			```
		displayFolder: Filterformål
		lineageTag: fe786765-6a39-446b-ab36-9abe831a6cd5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Dansk månedsforkortelse (Jan, Feb, ..., Maj, ..., Okt). Svarer til BC Accelerator [Month Abbr.]
	column 'Month Abbr.' =
			SWITCH (
			    MONTH ( 'Calendar'[Date] ),
			    1, "Jan", 2, "Feb", 3, "Mar", 4, "Apr", 5, "Maj", 6, "Jun",
			    7, "Jul", 8, "Aug", 9, "Sep", 10, "Okt", 11, "Nov", 12, "Dec"
			)
		displayFolder: Business Central
		lineageTag: de413584-cec2-47a6-b53e-867e833cf85e
		summarizeBy: none
		sortByColumn: MånedsNr

		annotation SummarizationSetBy = Automatic

	/// Dansk månedsnavn (Januar, Februar, ...). Svarer til BC Accelerator [Month Name]
	column 'Month Name' =
			SWITCH (
			    MONTH ( 'Calendar'[Date] ),
			    1, "Januar", 2, "Februar", 3, "Marts", 4, "April", 5, "Maj", 6, "Juni",
			    7, "Juli", 8, "August", 9, "September", 10, "Oktober", 11, "November", 12, "December"
			)
		displayFolder: Business Central
		lineageTag: d6027751-521e-4b2e-9e63-25cb40424021
		summarizeBy: none
		sortByColumn: MånedsNr

		annotation SummarizationSetBy = Automatic

	/// Format: 2026-Q3. Svarer til BC Accelerator [Year Quarter Caption]
	column 'Year Quarter Caption' = YEAR ( 'Calendar'[Date] ) & "-" & 'Calendar'[Kvartal]
		displayFolder: Business Central
		lineageTag: c6bc801e-089d-4696-b708-40dc3ed0c70c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// TRUE for rapporteringsårets datoer. Rapporteringsperioden er seneste afsluttede måned (måneden før i dag)
	column 'Current Year' = YEAR ( 'Calendar'[Date] ) = YEAR ( EOMONTH ( TODAY (), -1 ) )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Business Central
		lineageTag: f47cb6b1-de73-4961-8714-6ba6504a5b31
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// TRUE for rapporteringsmåneden (seneste afsluttede måned)
	column 'Current Month' = EOMONTH ( 'Calendar'[Date], 0 ) = EOMONTH ( TODAY (), -1 )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Business Central
		lineageTag: 5ba45932-c473-4243-8c5d-ad870be17138
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// TRUE for alle datoer til og med udgangen af rapporteringsmåneden
	column 'Up To Current Month' = 'Calendar'[Date] <= EOMONTH ( TODAY (), -1 )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Business Central
		lineageTag: f01c2b5b-b3f3-4a3f-ab60-1dd51f608593
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// TRUE for de 12 måneder til og med rapporteringsmåneden
	column 'Last 12 Months' =
			'Calendar'[Date] > EOMONTH ( TODAY (), -13 )
			    && 'Calendar'[Date] <= EOMONTH ( TODAY (), -1 )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Business Central
		lineageTag: ecee2fea-8461-4577-8050-e5ba7391d63d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy ÅMD
