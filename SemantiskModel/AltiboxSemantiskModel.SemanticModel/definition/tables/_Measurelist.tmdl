	measure 'Finance Amount BS LCY' =
			CALCULATE (
			    [Sum of Finance Amount LCY],
			    FILTER (
			        ALL ( 'Calendar'[Date] ),
			        'Calendar'[Date] <= MAX ( 'Calendar'[Date] )
			    ),
			    'Account'[Account Statement Type] = "Balance Sheet"
			)
		formatString: #,0
		displayFolder: Finance\1. Actuals\1. Base\_Support
		lineageTag: 752d7ec7-52ac-4170-bbe8-caf6e8a55d86

