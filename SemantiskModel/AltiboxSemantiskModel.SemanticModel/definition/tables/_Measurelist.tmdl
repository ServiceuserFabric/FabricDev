	measure 'DEV % (Actuals vs Budget)' =
			
			
			VAR _ACT = [Finance Amount]
			
			VAR _BUD = [Budget Amount]
			
			RETURN
			
			DIVIDE( (_ACT - _BUD) , _BUD )
		formatString: #,0
		displayFolder: Finance\1. Actuals\2. Rapportering\Amount\P&L
		lineageTag: 87e7be40-f45b-4f57-8767-b57c62c72a13

