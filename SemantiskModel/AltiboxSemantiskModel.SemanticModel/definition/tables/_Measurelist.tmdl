table _Measurelist
	lineageTag: a2132765-eb76-489d-b6ac-a94fb9dc7c0e

	measure 'Actuals YTD' =
			
			CALCULATE (
			            [Finance Amount],            DATESYTD ('Calendar'[Date] ),
			            ALL('Calendar'[Date])
			            )
		formatString: #,0
		displayFolder: Finance\1. Actuals\2. Rapportering\Amount\P&L
		lineageTag: a164a78d-35f8-48b3-8057-6683895252d7

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Actuals YTD LY' = CALCULATE([Actuals YTD], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0
		displayFolder: Finance\1. Actuals\2. Rapportering\Amount\P&L
		lineageTag: 62654858-b11c-4ef1-bccd-547add838b62

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Actuals, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Finance Amount],'Account Schedule'[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( 'Account Schedule')
			    )
			VAR _Actuals =
			    ABS( [Finance Amount] )
			VAR _Result =
			    IF (
			        MAX ( 'Account Schedule'[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals, _Revenue )
			    )
			RETURN
			_Result
		formatString: #,0.0\ %;-#,0.0\ %;#,0.0\ %
		displayFolder: Finance\1. Actuals\2. Rapportering\%
		lineageTag: 7b70e64e-bf98-4725-b3fe-ac07bb152f8e

	measure 'Budget Amount' =
			SWITCH (
			    SELECTEDVALUE ( 'Currency Display'[Currency Display], "LCY" ),
			    "GCY", SUM ( 'Finance Budgets'[Budget Amount GCY] ),
			    SUM ( 'Finance Budgets'[Budget Amount] )
			)
		formatString: #,0
		displayFolder: Finance\2. Budget\1. Base
		lineageTag: 618fbf43-4d9d-43de-9804-d6eaba69a0a1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Estimate = ```
			VAR _BudgetFY = [Budget FY]
			
			VAR _BudgetYTD = [Budget YTD]
			
			VAR _ActualYTD = [Actuals YTD]
			
			VAR _RESULT = _BudgetFY - _BudgetYTD + _ActualYTD
			
			RETURN
			    
			_RESULT
			
			
			
			
			
			```
		formatString: #,0
		displayFolder: Finance\2. Budget\2. Rapportering\Forecast
		lineageTag: 9814e3f0-7cee-4cfb-a8a4-8f989701b490

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Actual LY Index' = DIVIDE([Finance Amount], [Actuals LY])*100
		displayFolder: Finance\1. Actuals\2. Rapportering\Index
		lineageTag: 390e6944-8356-4b1c-ac00-d8f3a4dbb36c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actuals LY, %' =
			
			VAR _Revenue =
			    CALCULATE (
			        [Actuals LY],
			        'Account Schedule'[Account Schedule - Level 1] = "OMSÆTNING",
			        ALL ( 'Account Schedule')
			    )
			VAR _Actuals_LY =
			    ABS ( [Actuals LY] )
			VAR _Result =
			    IF (
			        MAX ( 'Account Schedule'[Account Schedule - Level 1] ) = "OMSÆTNING",
			        "",
			        DIVIDE ( _Actuals_LY, _Revenue )
			    )
			RETURN
			_Result
		displayFolder: Finance\1. Actuals\2. Rapportering\%
		lineageTag: 3a209a60-4f72-4116-a6a4-b822a6c333ef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DEV (Actuals vs Budget)' = [Finance Amount] - [Budget Amount]
		formatString: #,0
