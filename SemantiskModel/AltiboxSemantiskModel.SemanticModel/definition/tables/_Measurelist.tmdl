	measure 'Finance Amount BS LCY Budget' =
			CALCULATE (
			    [Sum of Finance Amount LCY],
			    FILTER (
			        ALL ( 'Calendar'[Date] ),
			        'Calendar'[Date] <= MAX ( 'Calendar'[Date] )
			    ),
			    'Account'[Account Statement Type] = "Balance Sheet"
			)
